---
import {
  formatNumber,
  formatPrice,
  isLease,
  leaseRate,
  leaseSqftRange,
  listingHref,
  type SearchItem,
} from "../lib/crexi";

interface Props {
  listing: SearchItem;
  index: number;
}

const { listing, index } = Astro.props;

const lease = isLease(listing);
const address = listing.address?.[0];
const image = listing.gallery?.thumbnailUrls?.[0];
const acres = formatNumber(listing.lotAttributes?.sizeAcre, 2);
const sqft = formatNumber(listing.propertyAttributes?.buildingSqft);

const vacancies = listing.vacancyDetails?.vacantUnitsCount ?? 0;
const headline = lease
  ? (leaseRate(listing) ?? "Rate on request")
  : (formatPrice(listing.propertyPrice?.total) ?? "Price on request");

const facts = [
  lease ? leaseSqftRange(listing) : sqft && `${sqft} SF`,
  lease ? listing.leaseDetails?.[0]?.leaseType : acres && `${acres} AC`,
  lease && vacancies > 1 && `${vacancies} spaces`,
  listing.propertyAttributes?.classType && `Class ${listing.propertyAttributes.classType}`,
  listing.constructionYear?.built && `Built ${listing.constructionYear.built}`,
].filter(Boolean);
---

<a
  href={listingHref(listing)}
  data-listing-type={lease ? "lease" : "sale"}
  target={lease ? "_blank" : undefined}
  rel={lease ? "noopener" : undefined}
  data-animate
  data-delay={0.12 + (index % 3) * 0.06}
  class="group border-brand-blue/15 hover:border-brand-gold flex flex-col overflow-hidden rounded-lg border bg-white transition-colors"
>
  <div class="relative aspect-3/2 overflow-hidden bg-gray-100">
    {
      image ? (
        <img
          src={image}
          alt={listing.propertyName}
          loading={index < 3 ? "eager" : "lazy"}
          class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="text-brand-blue/40 font-fraunces flex size-full items-center justify-center text-sm">
          Photo coming soon
        </div>
      )
    }
    <span
      class="bg-brand-blue absolute top-3 left-3 rounded px-2 py-1 text-xs font-semibold tracking-wide text-white uppercase"
    >
      {lease ? "For Lease" : "For Sale"}
    </span>
    {
      listing.propertyAttributes?.type && (
        <span class="text-brand-blue absolute top-3 right-3 rounded bg-white/90 px-2 py-1 text-xs font-semibold tracking-wide uppercase backdrop-blur-sm">
          {listing.propertyAttributes.type}
        </span>
      )
    }
  </div>

  <div class="flex grow flex-col p-5">
    <p class="font-fraunces text-brand-blue text-2xl">{headline}</p>
    <h2 class="mt-1 text-sm font-semibold">{address?.streetAddress ?? listing.propertyName}</h2>
    <p class="text-xs text-gray-600">
      {address ? `${address.city}, ${address.stateCode} ${address.zip}` : null}
    </p>
    {listing.description && <p class="mt-3 line-clamp-2 text-sm text-pretty text-gray-700">{listing.description}</p>}
    {
      facts.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2 text-xs text-gray-600">
          {facts.map((fact) => (
            <li class="rounded bg-gray-100 px-2 py-1">{fact}</li>
          ))}
        </ul>
      )
    }
    <span class="text-brand-blue group-hover:text-brand-gold mt-auto pt-5 text-sm font-semibold transition-colors">
      {lease ? "View on Crexi ↗" : "View details →"}
    </span>
  </div>
</a>
